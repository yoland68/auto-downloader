# Credentials for the Gemini summarizer + glance push.
# NEVER commit this file (.gitignore covers .env / .env.*).
# Loaded automatically by start.sh; for an interactive shell: set -a; . ./.env; set +a

# Gemini API key (starts "AQ.") -- ask Yoland
GEMINI_API_KEY=

# Supabase project (not a secret)
SUPABASE_URL=https://<project>.supabase.co

# Supabase service-role key -- ask Yoland (lives in the glance hub's .env)
SUPABASE_SERVICE_ROLE_KEY=
